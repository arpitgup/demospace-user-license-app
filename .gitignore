__pycache__
.pytest_cache
test.db


# --- Virtual Environment ---
# Ignore the virtual environment folder where packages are installed
venv/
.venv/
env/
.env/

# --- Python Cache & Compiled Files ---
# Ignore Python's generated cache and bytecode files
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Distribution / Packaging ---
# Ignore distribution and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Testing ---
# Ignore pytest and coverage tool artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml

# --- Editor / IDE specific ---
# Ignore configs for popular editors like VSCode and PyCharm
.vscode/
.env
*.egg-info
build
cloud_functions
.idea/

# --- OS-specific files ---
# Ignore files generated by macOS and Windows
.DS_Store
Thumbs.db
